{
  "name": "agent-picks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "gen": "tsx scripts/gen-agents.ts",
    "deploy": "opencomputer deploy && opencomputer deploy --alias production",
    "web": "OC_ENVIRONMENT=${OC_ENVIRONMENT:-production} tsx web/server.ts",
    "web:public": "APP_MODE=public OC_ENVIRONMENT=${OC_ENVIRONMENT:-production} tsx web/server.ts",
    "typecheck": "tsc -p .",
    "bundle:vercel": "esbuild web/vercel-entry.ts --bundle --platform=node --format=esm --target=node22 --outfile=api/index.js --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@opencomputer/agent": "^0.8.0",
    "@opencomputer/sdk": "^2.3.0",
    "@vercel/blob": "^2.8.1"
  },
  "devDependencies": {
    "@opencomputer/cli": "^0.7.0",
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
